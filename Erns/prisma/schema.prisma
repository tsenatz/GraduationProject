// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  AGENT
  ADMIN
}

enum MembershipTier {
  FREE
  STANDARD
  PREMIUM
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  firstName     String?
  lastName      String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // Hashed password for Credentials sign up/in
  role          Role      @default(USER)

  // 1-to-0..1 relationship with professional profile
  agentProfile AgentProfile?

  // User's saved/favorite properties
  favorites Favorite[]

  // User's listed properties
  properties Property[]

  // User's conversations & direct messages
  conversationsAsBuyer  Conversation[] @relation("BuyerConversations")
  conversationsAsSeller Conversation[] @relation("SellerConversations")
  messagesSent          Message[]      @relation("SentMessages")

  // Web Push API subscriptions for background notifications
  pushSubscriptions     PushSubscription[]

  // Membership Tier & Contact Credits
  tier                  MembershipTier   @default(FREE)
  contactCredits        Int              @default(0)
  unlimitedExpiresAt    DateTime?
  unlockedProperties    PropertyUnlock[]

  accounts      Account[]
  sessions      Session[]
  // Optional for WebAuthn support
  Authenticator Authenticator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName           String?
  fullNameAm         String?
  licenseNumber      String?
  tinNumber          String?
  licenseState       String?
  brokerage          String?
  experience         String?
  specialties        String[]           @default([])
  languages          String[]           @default(["Amharic", "English"])
  professionalPhone  String?
  professionalEmail  String?
  bio                String?
  bioAm              String?
  website            String?
  documentUrl        String?
  referenceNo        String?            @unique
  serviceAreas       String[]
  verificationStatus VerificationStatus @default(PENDING)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// User Saved / Favorite Properties
model Favorite {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String

  // Cached property details for offline & fast rendering
  title          String?
  titleAm        String?
  priceETB       Float?
  listingType    String?
  imageUrl       String?
  subCity        String?
  subCityAm      String?
  specificArea   String?
  specificAreaAm String?
  bedrooms       Int?
  bathrooms      Int?
  areaSqM        Float?
  propertyType   String?

  createdAt DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

// Property Listings (FSBO & Agent)
model Property {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  title           String
  titleAm         String?
  description     String?
  price           Float    // in ETB
  isNegotiable    Boolean  @default(true)

  // Property Details
  beds            Int      @default(1)
  baths           Float    @default(1)
  sqft            Int      @default(100)
  areaSqM         Float?
  propertyType    String   @default("Apartment")
  status          String   @default("FOR_SALE") // "FOR_SALE", "FOR_RENT", "PENDING", "SOLD"
  listingType     String   @default("SALE")     // "SALE", "RENT"
  titleDeedStatus String?

  // Location Data
  subCity         String?
  subCityAm       String?
  woreda          String?
  specificArea    String?
  specificAreaAm  String?
  address         String
  city            String   @default("Addis Ababa")
  state           String   @default("Addis Ababa")
  zipCode         String   @default("1000")
  latitude        Float    @default(9.0107)
  longitude       Float    @default(38.7612)

  // Features & Media
  amenities       String[] @default([])
  images          String[] @default([])

  // Contact
  ownerName       String?
  contactPhone    String?
  preferredTime   String?  @default("anytime")

  referenceNo     String   @unique @default(cuid())

  conversations   Conversation[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([subCity])
  @@index([latitude, longitude])
}

// Real Estate Messaging & Tour Negotiations
model Conversation {
  id               String    @id @default(cuid())
  buyerId          String
  buyer            User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId         String
  seller           User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  propertyId       String?
  property         Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  // Snapshot cache of property for fast rendering
  propertyTitle    String?
  propertyTitleAm  String?
  propertyPrice    Float?
  propertyImage    String?
  propertySubCity  String?
  listingType      String?   @default("SALE") // "SALE" | "RENT"

  category         String    @default("buy")   // "buy" | "rent" | "sell" | "landlord"
  inquiryType      String    @default("inquiry") // "inquiry" | "tour" | "offer"
  isArchivedBuyer  Boolean   @default(false)
  isArchivedSeller Boolean   @default(false)
  isStarredBuyer   Boolean   @default(false)
  isStarredSeller  Boolean   @default(false)
  lastMessageAt    DateTime  @default(now())

  messages         Message[]

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([buyerId])
  @@index([sellerId])
  @@index([propertyId])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  senderName     String?
  senderRole     String?      // "buyer" | "seller" | "agent" | "renter" | "owner"
  content        String
  type           String       @default("text") // "text" | "tour_request" | "attachment"

  // Tour / Attachment metadata
  tourDate       String?
  tourTime       String?
  tourStatus     String?      // "pending" | "confirmed" | "declined"
  fileName       String?
  fileSize       String?
  fileUrl        String?

  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// User unlocked property contact records
model PropertyUnlock {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}


