// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  AGENT
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  firstName     String?
  lastName      String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // Hashed password for Credentials sign up/in
  role          Role      @default(USER)

  // 1-to-0..1 relationship with professional profile
  agentProfile AgentProfile?

  // User's saved/favorite properties
  favorites Favorite[]

  // User's listed properties
  properties Property[]

  accounts      Account[]
  sessions      Session[]
  // Optional for WebAuthn support
  Authenticator Authenticator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName           String?
  fullNameAm         String?
  licenseNumber      String?
  tinNumber          String?
  licenseState       String?
  brokerage          String?
  experience         String?
  specialties        String[]           @default([])
  languages          String[]           @default(["Amharic", "English"])
  professionalPhone  String?
  professionalEmail  String?
  bio                String?
  bioAm              String?
  website            String?
  documentUrl        String?
  referenceNo        String?            @unique
  serviceAreas       String[]
  verificationStatus VerificationStatus @default(PENDING)

  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// User Saved / Favorite Properties
model Favorite {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String

  // Cached property details for offline & fast rendering
  title          String?
  titleAm        String?
  priceETB       Float?
  listingType    String?
  imageUrl       String?
  subCity        String?
  subCityAm      String?
  specificArea   String?
  specificAreaAm String?
  bedrooms       Int?
  bathrooms      Int?
  areaSqM        Float?
  propertyType   String?

  createdAt DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

// Property Listings (FSBO & Agent)
model Property {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  title           String
  titleAm         String?
  description     String?
  price           Float    // in ETB
  isNegotiable    Boolean  @default(true)

  // Property Details
  beds            Int      @default(1)
  baths           Float    @default(1)
  sqft            Int      @default(100)
  areaSqM         Float?
  propertyType    String   @default("Apartment")
  status          String   @default("FOR_SALE") // "FOR_SALE", "FOR_RENT", "PENDING", "SOLD"
  listingType     String   @default("SALE")     // "SALE", "RENT"
  titleDeedStatus String?

  // Location Data
  subCity         String?
  subCityAm       String?
  woreda          String?
  specificArea    String?
  specificAreaAm  String?
  address         String
  city            String   @default("Addis Ababa")
  state           String   @default("Addis Ababa")
  zipCode         String   @default("1000")
  latitude        Float    @default(9.0107)
  longitude       Float    @default(38.7612)

  // Features & Media
  amenities       String[] @default([])
  images          String[] @default([])

  // Contact
  ownerName       String?
  contactPhone    String?
  preferredTime   String?  @default("anytime")

  referenceNo     String   @unique @default(cuid())

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([subCity])
  @@index([latitude, longitude])
}
