// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  AGENT
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  firstName     String?
  lastName      String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // Hashed password for Credentials sign up/in
  role          Role      @default(USER)

  // 1-to-0..1 relationship with professional profile
  agentProfile AgentProfile?

  // User's saved/favorite properties
  favorites Favorite[]

  // User's listed properties
  properties Property[]

  accounts      Account[]
  sessions      Session[]
  // Optional for WebAuthn support
  Authenticator Authenticator[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  licenseNumber      String?
  licenseState       String?
  brokerage          String?
  professionalPhone  String?
  professionalEmail  String?
  bio                String?
  serviceAreas       String[]
  verificationStatus VerificationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

// User Saved / Favorite Properties
model Favorite {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String

  // Cached property details for offline & fast rendering
  title          String?
  titleAm        String?
  priceETB       Float?
  listingType    String?
  imageUrl       String?
  subCity        String?
  subCityAm      String?
  specificArea   String?
  specificAreaAm String?
  bedrooms       Int?
  bathrooms      Int?
  areaSqM        Float?
  propertyType   String?

  createdAt DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
  @@index([propertyId])
}

// Model for property listings and their details
model Property {
  id          String   @id @default(cuid())
  title       String
  description String?
  price       Float

  // Property Details
  beds        Int
  baths       Float
  sqft        Int
  propertyType String  // e.g., "Single Family", "Condo", "Townhouse"
  status      String   // e.g., "FOR_SALE", "FOR_RENT"

  // Location Data
  address     String
  city        String
  state       String
  zipCode     String
  latitude    Float    // Crucial for map plotting
  longitude   Float    // Crucial for map plotting

  // Images
  images      String[] // Array of image URLs

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

